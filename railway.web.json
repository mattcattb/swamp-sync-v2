{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter=@swamp-sync-v2/web build",
    "watchPatterns": ["/packages/web/**", "/package.json", "/bun.lock"]
  },
  "deploy": {
    "startCommand": "bun run --filter=@swamp-sync-v2/web start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "sleepApplication": true,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
